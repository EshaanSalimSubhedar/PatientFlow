<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_patient-referral-triage" targetNamespace="http://patientflow.example"><bpmn:process id="patient-referral-triage" name="Patient Referral and Triage" isExecutable="true"><bpmn:startEvent id="Start_Referral" name="Referral submitted"><bpmn:outgoing>F_Start_Fetch</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="Task_FetchVitals" name="Fetch patient vitals"><bpmn:extensionElements><zeebe:taskDefinition type="fetch-patient-vitals" retries="3" /></bpmn:extensionElements><bpmn:incoming>F_Start_Fetch</bpmn:incoming><bpmn:outgoing>F_Fetch_Gateway</bpmn:outgoing></bpmn:serviceTask><bpmn:boundaryEvent id="Boundary_VitalsError" name="Vitals unavailable" attachedToRef="Task_FetchVitals"><bpmn:outgoing>F_Error_Manual</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_VitalsUnavailable" /></bpmn:boundaryEvent><bpmn:serviceTask id="Task_ManualVitals" name="Manual vitals review"><bpmn:extensionElements><zeebe:taskDefinition type="manual-vitals-review" retries="3" /></bpmn:extensionElements><bpmn:incoming>F_Error_Manual</bpmn:incoming><bpmn:outgoing>F_Manual_Gateway</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_Critical" name="Critical result?" default="F_Routine"><bpmn:incoming>F_Fetch_Gateway</bpmn:incoming><bpmn:incoming>F_Manual_Gateway</bpmn:incoming><bpmn:outgoing>F_Critical</bpmn:outgoing><bpmn:outgoing>F_Routine</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_Emergency" name="Emergency clinical escalation"><bpmn:extensionElements><zeebe:taskDefinition type="emergency-clinical-escalation" retries="3" /></bpmn:extensionElements><bpmn:incoming>F_Critical</bpmn:incoming><bpmn:outgoing>F_Emergency_Merge</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="F_Critical" sourceRef="Gateway_Critical" targetRef="Task_Emergency"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=criticalResult = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_Routine" sourceRef="Gateway_Critical" targetRef="Gateway_Merge" /><bpmn:exclusiveGateway id="Gateway_Merge" name="Continue referral"><bpmn:incoming>F_Routine</bpmn:incoming><bpmn:incoming>F_Emergency_Merge</bpmn:incoming><bpmn:outgoing>F_Merge_Consult</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_SpecialistConsult" name="Specialist consultations (parallel)"><bpmn:extensionElements><zeebe:taskDefinition type="specialist-consultation" retries="3" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=specialists" inputElement="specialist" outputCollection="specialistResults" outputElement="=specialistResult" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics><bpmn:incoming>F_Merge_Consult</bpmn:incoming><bpmn:outgoing>F_Consult_Diagnostics</bpmn:outgoing></bpmn:serviceTask><bpmn:boundaryEvent id="Boundary_SpecialistTimer" name="4-hour SLA timer" attachedToRef="Task_SpecialistConsult" cancelActivity="true"><bpmn:outgoing>F_Timer_Escalation</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:serviceTask id="Task_SlaEscalation" name="Escalate overdue referral"><bpmn:extensionElements><zeebe:taskDefinition type="specialist-sla-escalation" retries="3" /></bpmn:extensionElements><bpmn:incoming>F_Timer_Escalation</bpmn:incoming><bpmn:outgoing>F_Timer_End</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Sla" name="Escalated for follow-up"><bpmn:incoming>F_Timer_End</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Task_DiagnosticReports" name="Collect diagnostic reports (sequential)"><bpmn:extensionElements><zeebe:taskDefinition type="diagnostic-report-collection" retries="3" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="true"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=diagnosticTypes" inputElement="diagnosticType" outputCollection="diagnosticResults" outputElement="=diagnosticResult" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics><bpmn:incoming>F_Consult_Diagnostics</bpmn:incoming><bpmn:outgoing>F_Diagnostics_Call</bpmn:outgoing></bpmn:serviceTask><bpmn:callActivity id="Call_ConsentEhr" name="Patient consent and EHR sync" calledElement="patient-consent-ehr-sync"><bpmn:extensionElements><zeebe:calledElement processId="patient-consent-ehr-sync" propagateAllChildVariables="false" /><zeebe:ioMapping><zeebe:input source="=referralId" target="referralId" /><zeebe:input source="=consentGiven" target="consentGiven" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>F_Diagnostics_Call</bpmn:incoming><bpmn:outgoing>F_Call_End</bpmn:outgoing></bpmn:callActivity><bpmn:endEvent id="End_Complete" name="Referral coordinated"><bpmn:incoming>F_Call_End</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F_Start_Fetch" sourceRef="Start_Referral" targetRef="Task_FetchVitals" /><bpmn:sequenceFlow id="F_Fetch_Gateway" sourceRef="Task_FetchVitals" targetRef="Gateway_Critical" /><bpmn:sequenceFlow id="F_Error_Manual" sourceRef="Boundary_VitalsError" targetRef="Task_ManualVitals" /><bpmn:sequenceFlow id="F_Manual_Gateway" sourceRef="Task_ManualVitals" targetRef="Gateway_Critical" /><bpmn:sequenceFlow id="F_Emergency_Merge" sourceRef="Task_Emergency" targetRef="Gateway_Merge" /><bpmn:sequenceFlow id="F_Merge_Consult" sourceRef="Gateway_Merge" targetRef="Task_SpecialistConsult" /><bpmn:sequenceFlow id="F_Consult_Diagnostics" sourceRef="Task_SpecialistConsult" targetRef="Task_DiagnosticReports" /><bpmn:sequenceFlow id="F_Diagnostics_Call" sourceRef="Task_DiagnosticReports" targetRef="Call_ConsentEhr" /><bpmn:sequenceFlow id="F_Timer_Escalation" sourceRef="Boundary_SpecialistTimer" targetRef="Task_SlaEscalation" /><bpmn:sequenceFlow id="F_Timer_End" sourceRef="Task_SlaEscalation" targetRef="End_Sla" /><bpmn:sequenceFlow id="F_Call_End" sourceRef="Call_ConsentEhr" targetRef="End_Complete" /></bpmn:process><bpmn:error id="Error_VitalsUnavailable" name="Vitals unavailable" errorCode="VITALS_UNAVAILABLE" /><bpmndi:BPMNDiagram id="Diagram_Main"><bpmndi:BPMNPlane id="Plane_Main" bpmnElement="patient-referral-triage"><bpmndi:BPMNShape id="Start_Referral_di" bpmnElement="Start_Referral"><dc:Bounds x="80" y="180" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_FetchVitals_di" bpmnElement="Task_FetchVitals"><dc:Bounds x="160" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Critical_di" bpmnElement="Gateway_Critical"><dc:Bounds x="320" y="175" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Emergency_di" bpmnElement="Task_Emergency"><dc:Bounds x="430" y="65" width="130" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge"><dc:Bounds x="610" y="175" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_SpecialistConsult_di" bpmnElement="Task_SpecialistConsult"><dc:Bounds x="710" y="160" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_DiagnosticReports_di" bpmnElement="Task_DiagnosticReports"><dc:Bounds x="920" y="160" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Call_ConsentEhr_di" bpmnElement="Call_ConsentEhr"><dc:Bounds x="1130" y="160" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Complete_di" bpmnElement="End_Complete"><dc:Bounds x="1350" y="182" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ManualVitals_di" bpmnElement="Task_ManualVitals"><dc:Bounds x="170" y="330" width="130" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_SlaEscalation_di" bpmnElement="Task_SlaEscalation"><dc:Bounds x="730" y="340" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Sla_di" bpmnElement="End_Sla"><dc:Bounds x="950" y="362" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Boundary_VitalsError_di" bpmnElement="Boundary_VitalsError"><dc:Bounds x="200" y="224" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Boundary_SpecialistTimer_di" bpmnElement="Boundary_SpecialistTimer"><dc:Bounds x="765" y="224" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="F_Start_Fetch_di" bpmnElement="F_Start_Fetch"><di:waypoint x="116" y="198" /><di:waypoint x="160" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Fetch_Gateway_di" bpmnElement="F_Fetch_Gateway"><di:waypoint x="270" y="200" /><di:waypoint x="320" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Error_Manual_di" bpmnElement="F_Error_Manual"><di:waypoint x="218" y="242" /><di:waypoint x="218" y="330" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Manual_Gateway_di" bpmnElement="F_Manual_Gateway"><di:waypoint x="300" y="370" /><di:waypoint x="345" y="225" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Critical_di" bpmnElement="F_Critical"><di:waypoint x="345" y="175" /><di:waypoint x="345" y="105" /><di:waypoint x="430" y="105" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Routine_di" bpmnElement="F_Routine"><di:waypoint x="370" y="200" /><di:waypoint x="610" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Emergency_Merge_di" bpmnElement="F_Emergency_Merge"><di:waypoint x="560" y="105" /><di:waypoint x="635" y="105" /><di:waypoint x="635" y="175" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Merge_Consult_di" bpmnElement="F_Merge_Consult"><di:waypoint x="660" y="200" /><di:waypoint x="710" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Consult_Diagnostics_di" bpmnElement="F_Consult_Diagnostics"><di:waypoint x="860" y="200" /><di:waypoint x="920" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Diagnostics_Call_di" bpmnElement="F_Diagnostics_Call"><di:waypoint x="1070" y="200" /><di:waypoint x="1130" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Call_End_di" bpmnElement="F_Call_End"><di:waypoint x="1280" y="200" /><di:waypoint x="1350" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Timer_Escalation_di" bpmnElement="F_Timer_Escalation"><di:waypoint x="800" y="242" /><di:waypoint x="800" y="340" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_Timer_End_di" bpmnElement="F_Timer_End"><di:waypoint x="880" y="380" /><di:waypoint x="950" y="380" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>